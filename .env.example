APP_ENV=development
APP_NAME=GolanInvite
APP_HOST=0.0.0.0
APP_PORT=8080

APP_DOMAIN=localhost
APP_BASE_URL=http://localhost:8080
PUBLIC_BASE_DOMAIN=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/golaninvite?sslmode=disable

SESSION_SECRET=super-secret-session-key-change-in-production
CSRF_SECRET=super-secret-csrf-key-change-in-production
ENCRYPTION_KEY=super-secret-encryption-key-32ch

ADMIN_EMAIL=admin@golaninvite.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Super Administrator

MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=info
